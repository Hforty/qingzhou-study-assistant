<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp" android:background="@drawable/widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="轻舟 · 今日学习" android:textColor="@color/widget_muted" android:textSize="12sp"/>
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="把今天，学踏实" android:textColor="@color/widget_ink" android:textSize="18sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:text="打开轻舟安排今天" android:textColor="@color/widget_muted" android:textSize="12sp" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_start" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:background="@drawable/widget_button" android:text="打开轻舟" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp"/>
</LinearLayout>
